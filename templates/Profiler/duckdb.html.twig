{% extends '@WebProfiler/Profiler/layout.html.twig' %}
{% block toolbar %}
    {% if collector.count %}
        {% set icon %}<span class="sf-toolbar-value">DuckDB</span><span class="sf-toolbar-info-piece-additional">{{ collector.count }} / {{ collector.duration|number_format(1) }} ms</span>{% endset %}
        {% set text %}<div class="sf-toolbar-info-piece"><b>Search queries</b><span>{{ collector.count }}</span></div><div class="sf-toolbar-info-piece"><b>SQL execution</b><span>{{ collector.duration|number_format(2) }} ms</span></div>{% endset %}
        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url}) }}
    {% endif %}
{% endblock %}
{% block menu %}<span class="label"><strong>DuckDB</strong><span class="count">{{ collector.count }}</span></span>{% endblock %}
{% block panel %}
    <h2>DuckDB search queries</h2>
    <p>{{ collector.count }} queries · {{ collector.duration|number_format(2) }} ms SQL execution. Native PDO; connection setup and extension loading are excluded.</p>
    {% for query in collector.queries %}
        <h3>{{ query.dataset }} · {{ query.milliseconds|number_format(2) }} ms</h3>
        <pre>{{ query.sql }}</pre><pre>{{ query.parameters|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% if query.error %}<p class="text-error">{{ query.error }}</p>{% endif %}
    {% else %}<p>No DuckDB search queries.</p>{% endfor %}
{% endblock %}
