{# Controller ids via kit-bundle's survos_stimulus() -- see bu/AGENTS.md. The
   `data-ux-search-facet-*` attributes are plain markers read by closest()/dataset in
   controller.js, so they stay literal and are not scoped to an identifier. #}
{% set _sc = survos_stimulus('search-bundle', 'ux-search') %}
{% set _rs = survos_stimulus('search-bundle', 'ux-search-range-slider') %}
<fieldset {{ attributes.defaults({
    'class': 'ux-search-facet ux-search-range-slider card',
    'data-ux-search-facet-collapsed': (this.collapsible and this.collapsed) ? 'true' : 'false',
    'data-ux-search-facet-expand-label': 'facet.expand'|trans({'%facet%': label}, domain='survos_search'),
    'data-ux-search-facet-collapse-label': 'facet.collapse'|trans({'%facet%': label}, domain='survos_search'),
    'data-skip-morph': true
}|merge(stimulus_controller(_rs, {
    leading: this.leading|default(''),
    trailing: this.trailing|default('')
}).toArray())) }}>
    <legend class="ux-search-facet__title card-header d-flex align-items-center justify-content-between gap-2">
        <span class="ux-search-facet__title-group d-inline-flex align-items-center gap-1 min-w-0">
            <span
                class="ux-search-facet__title-text"
                {% if this.collapsible %}
                    role="button"
                    tabindex="0"
                    aria-expanded="{{ this.collapsed ? 'false' : 'true' }}"
                    aria-controls="{{ property }}-facet-panel"
                    data-ux-search-facet-toggle
                    {{ stimulus_action(_sc, 'toggleFacetCollapse', 'click')
                        |stimulus_action(_sc, 'toggleFacetCollapse', 'keydown.enter')
                        |stimulus_action(_sc, 'toggleFacetCollapse', 'keydown.space') }}
                {% endif %}
            >{{ label }}</span>
            {% if this.collapsible %}
                <button
                    class="ux-search-facet__collapse btn btn-action btn-sm"
                    type="button"
                    aria-expanded="{{ this.collapsed ? 'false' : 'true' }}"
                    aria-controls="{{ property }}-facet-panel"
                    data-ux-search-facet-toggle
                    {{ stimulus_action(_sc, 'toggleFacetCollapse') }}
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    <span class="ux-search-sr-only" data-ux-search-facet-label>
                        {{ (this.collapsed ? 'facet.expand' : 'facet.collapse')|trans({'%facet%': label}, domain='survos_search') }}
                    </span>
                </button>
            {% endif %}
        </span>
    </legend>

    <div
        class="card-body ux-search-facet__panel"
        id="{{ property }}-facet-panel"
        data-ux-search-facet-panel
        {% if this.collapsible and this.collapsed %}hidden{% endif %}
    >
        <form
            class="ux-search-range-slider__form"
            {{ stimulus_target(_rs, 'form') }}
            {{ stimulus_action(_sc, 'updateFacetRange:prevent', 'submit', {
                property: property,
                rangeMin: facetStat.min,
                rangeMax: facetStat.max
            }) }}
        >
            <input
                id="{{ property }}-min"
                name="{{ property }}-min"
                aria-label="Minimum {{ property }}"
                aria-describedby="{{ property }}-min-value"
                class="ux-search-range-slider__input ux-search-range-slider__input--min form-range"
                type="range"
                min="{{ facetStat.min }}"
                max="{{ facetStat.max }}"
                placeholder="{{ facetStat.min }}"
                value="{{ (facetStat.userMin is not null) ? facetStat.userMin : facetStat.min }}"
                step="{{ this.step }}"
                {{ stimulus_target(_rs, 'minInput') }}
                {{ stimulus_action(_rs, 'updateCeil', 'input')
                    |stimulus_action(_rs, 'updateCeil', 'focus')
                    |stimulus_action(_rs, 'updateCeil', 'mousedown')
                    |stimulus_action(_rs, 'updateCeil', 'touchstart')
                    |stimulus_action(_rs, 'submit', 'change') }}
            />

            <input
                id="{{ property }}-max"
                name="{{ property }}-max"
                aria-label="Maximum {{ property }}"
                aria-describedby="{{ property }}-max-value"
                class="ux-search-range-slider__input ux-search-range-slider__input--max form-range"
                type="range"
                min="{{ facetStat.min }}"
                max="{{ facetStat.max }}"
                placeholder="{{ facetStat.max }}"
                value="{{ (facetStat.userMax is not null) ? facetStat.userMax : facetStat.max }}"
                step="{{ this.step }}"
                {{ stimulus_target(_rs, 'maxInput') }}
                {{ stimulus_action(_rs, 'updateFloor', 'input')
                    |stimulus_action(_rs, 'updateFloor', 'focus')
                    |stimulus_action(_rs, 'updateFloor', 'mousedown')
                    |stimulus_action(_rs, 'updateFloor', 'touchstart')
                    |stimulus_action(_rs, 'submit', 'change') }}
            />
        </form>

        <div class="ux-search-range-slider__values d-flex justify-content-between gap-2 mt-2">
            <span
                id="{{ property }}-min-value"
                class="ux-search-range-slider__value ux-search-range-slider__value--min badge bg-secondary-lt"
                {{ stimulus_target(_rs, 'minValue') }}
            >
                {{ this.leading ~ facetStat.userMin|default(facetStat.min) ~ this.trailing }}
            </span>

            <span
                id="{{ property }}-max-value"
                class="ux-search-range-slider__value ux-search-range-slider__value--max badge bg-secondary-lt"
                {{ stimulus_target(_rs, 'maxValue') }}
            >
                {{ this.leading ~ facetStat.userMax|default(facetStat.max) ~ this.trailing }}
            </span>
        </div>
    </div>
</fieldset>
