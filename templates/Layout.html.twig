{# Resolve the controller id through kit-bundle's helper (see bu/AGENTS.md) rather
   than hard-coding it. Hard-coding `data-controller="ux-search"` here is exactly why
   this controller never mounted in any consumer app: StimulusBundle registers it as
   `survos--search-bundle--ux-search`. survos_stimulus() derives that and validates it
   in dev against the installed UX bundles. #}
{% set _sc = survos_stimulus('search-bundle', 'ux-search') %}
<div {{ attributes.defaults({
    'class': 'ux-search',
    'data-loading': 'addClass(ux-search--is-loading)'
}|merge(stimulus_controller(_sc).toArray())) }}>
    {% block content %}
        <div class="ux-search__inner">
            <div class="ux-search__header">
                <div class="ux-search__form">
                    {% block form %}
                        {% if this.smartSearchAvailable %}
                            {% set coverage = search.resolvedAdapterParameters.vectorCoverage ?? null %}
                            {% if coverage and coverage.indexed < coverage.total %}
                                <p class="small text-muted">Smart Search coverage: {{ coverage.indexed }} of {{ coverage.total }} records have embeddings. Keyword search covers the full collection.</p>
                            {% endif %}
                            <div class="nav nav-tabs mb-3" role="tablist" aria-label="{{ 'mode.label'|trans(domain='survos_search') }}">
                                {% set modes = {lexical: 'mode.instant', semantic: 'mode.smart'} %}
                                {% if this.hybridSearchAvailable %}{% set modes = modes|merge({hybrid: 'mode.hybrid'}) %}{% endif %}
                                {% for mode, label in modes %}
                                    <button type="button" class="nav-link{{ this.searchTab == mode ? ' active' : '' }}" role="tab"
                                            id="{{ this.searchUiId }}-{{ mode }}-tab" aria-controls="{{ this.searchUiId }}-{{ mode }}-panel"
                                            aria-selected="{{ this.searchTab == mode ? 'true' : 'false' }}" tabindex="{{ this.searchTab == mode ? '0' : '-1' }}"
                                            data-search-tab="{{ mode }}" {{ stimulus_target(_sc, 'modeTab') }}
                                            {{ stimulus_action(_sc, 'selectSearchTab')|stimulus_action(_sc, 'selectSearchTab', 'keydown') }}>
                                        {{ label|trans(domain='survos_search') }}
                                    </button>
                                {% endfor %}
                            </div>
                            <div role="tabpanel" id="{{ this.searchUiId }}-lexical-panel" aria-labelledby="{{ this.searchUiId }}-lexical-tab"
                                 data-search-panel="lexical" {{ stimulus_target(_sc, 'modePanel') }} {{ this.searchTab != 'lexical' ? 'hidden' : '' }}>
                                <input type="search" class="ux-search-search-input ux-search-input form-control" data-model="debounce(400)|keywordQuery"
                                       value="{{ this.keywordQuery }}" placeholder="{{ 'search.placeholder'|trans(domain='survos_search') }}" aria-label="{{ 'mode.instant'|trans(domain='survos_search') }}">
                            </div>
                            {% for mode in this.hybridSearchAvailable ? ['semantic', 'hybrid'] : ['semantic'] %}
                            <div role="tabpanel" id="{{ this.searchUiId }}-{{ mode }}-panel" aria-labelledby="{{ this.searchUiId }}-{{ mode }}-tab"
                                 data-search-panel="{{ mode }}" {{ stimulus_target(_sc, 'modePanel') }} {{ this.searchTab != mode ? 'hidden' : '' }}>
                                <form data-search-mode="{{ mode }}" {{ stimulus_action(_sc, 'submitSmartSearch', 'submit') }}>
                                    <label class="form-label w-100">{{ 'mode.describe'|trans(domain='survos_search') }}
                                        <textarea class="form-control mt-2" name="description" rows="3" required maxlength="2000"
                                                  data-model="norender|smartQuery" placeholder="{{ 'mode.placeholder'|trans(domain='survos_search') }}">{{ this.smartQuery }}</textarea>
                                    </label>
                                    <p class="text-muted small">{{ 'mode.submit_hint'|trans(domain='survos_search') }}</p>
                                    <details class="my-3">
                                        <summary>{{ 'mode.settings'|trans(domain='survos_search') }}</summary>
                                        <label class="form-label mt-2">{{ 'mode.similarity'|trans(domain='survos_search') }}
                                            <input type="number" min="-1" max="1" step="0.05" class="form-control" data-model="norender|query.minimumSimilarity" value="{{ query.minimumSimilarity ?? search.resolvedAdapterParameters.minimumSimilarity }}">
                                        </label>
                                        {% if mode == 'hybrid' %}
                                            <label class="form-label mt-2">Semantic candidates (1–1000)
                                                <input type="number" min="1" max="1000" step="1" class="form-control" data-model="norender|query.semanticCandidates" value="{{ query.semanticCandidates }}">
                                            </label>
                                            <p class="small text-muted">Combine keyword matches with this many semantic candidates using reciprocal rank fusion. Scores reflect rank agreement.</p>
                                        {% endif %}
                                    </details>
                                    <p data-smart-error class="text-danger" {{ stimulus_target(_sc, 'smartError') }} hidden>{{ 'mode.error'|trans(domain='survos_search') }}</p>
                                    <button type="submit" class="btn btn-primary">{{ 'mode.search'|trans(domain='survos_search') }}</button>
                                    {% if query.searchMode == mode %}
                                        <p class="small mt-2" role="status">{{ 'mode.active'|trans({'%query%': query.queryString}, domain='survos_search') }}</p>
                                    {% endif %}
                                </form>
                            </div>
                            {% endfor %}
                        {% else %}
                            <twig:Survos:Search:SearchInput />
                        {% endif %}
                    {% endblock %}
                </div>
                <div class="d-flex align-items-center gap-2">
                    <twig:Survos:Search:HitsPerPage />
                    {% if query.searchMode == 'lexical' %}<twig:Survos:Search:SortBy />{% else %}<span class="small text-muted">Ranked by relevance</span>{% endif %}
                </div>
            </div>

            <div class="ux-search__toolbar">
                {% block toolbar %}
                    <div class="d-flex align-items-end gap-2 flex-wrap">
                        <twig:Survos:Search:CurrentRefinements />
                        <twig:Survos:Search:ClearRefinements />
                    </div>
                {% endblock %}
                <div class="ux-search__stats">
                    {% block stats %}
                        <twig:Survos:Search:TotalHits/>
                    {% endblock %}
                </div>
            </div>

            <div
                class="ux-search__facets offcanvas-md offcanvas-start"
                tabindex="-1"
                id="uxSearchFacets"
            >
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title fw-bold">
                        Filters
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="offcanvas"
                        data-bs-target="#uxSearchFacets"
                    ></button>
                </div>

                <div class="offcanvas-body">
                    {# Facets carrying a #[Field(group:)] collapse into one block per group (Merit,
                       Admin, ...) so eight sliders stop repeating the group's name; ungrouped ones
                       render as before, above the groups. A group named Admin starts collapsed --
                       stage and other plumbing facets are not what a visitor came for. #}
                    {% for facet in search.facets|filter(f => f.group is null) %}
                        <twig:Survos:Search:Facet :property="facet.property" />
                    {% endfor %}

                    {% set facetGroups = {} %}
                    {% for facet in search.facets|filter(f => f.group is not null) %}
                        {% set facetGroups = facetGroups|merge({ (facet.group): (facetGroups[facet.group]|default([]))|merge([facet]) }) %}
                    {% endfor %}
                    {% for group, groupFacets in facetGroups %}
                        {% set groupId = 'ux-search-facet-group-' ~ group|lower|replace({' ': '-', '&': 'and', '/': '-'}) %}
                        {% set startsOpen = group|lower != 'admin' %}
                        <div class="ux-search-facet ux-search-facet-group">
                            <button class="ux-search-facet__title d-flex align-items-center justify-content-between gap-2 w-100 border-0 bg-transparent text-start"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#{{ groupId }}"
                                    aria-expanded="{{ startsOpen ? 'true' : 'false' }}" aria-controls="{{ groupId }}">
                                <span class="ux-search-facet__title-text">{{ group }}</span>
                                <span class="ux-search-refinement-list__count">{{ groupFacets|length }}</span>
                            </button>
                            <div class="collapse{{ startsOpen ? ' show' : '' }} ux-search-facet-group__body" id="{{ groupId }}">
                                {% for facet in groupFacets %}
                                    <twig:Survos:Search:Facet :property="facet.property" />
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="offcanvas-footer">
                    <twig:Survos:Search:ClearRefinements />
                </div>
            </div>

            <div class="ux-search__listing">
                {% block listing %}
                    {% block hits %}
                        <twig:Survos:Search:Hits />
                    {% endblock %}

                    {% block pagination %}
                        <twig:Survos:Search:Pagination />
                    {% endblock %}
                {% endblock %}
            </div>
        </div>

        <button
            type="button"
            class="btn btn-primary btn-filter-offcanvas d-md-none"
            data-bs-toggle="offcanvas"
            data-bs-target="#uxSearchFacets"
            aria-controls="uxSearchFacets"
        >
            {{ ux_icon('tabler:adjustments-horizontal', { class: 'icon me-1' }) }}
            Filters
        </button>
    {% endblock %}
</div>
